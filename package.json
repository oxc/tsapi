{
  "name": "@oxc/tsapi",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxc/tsapi.git"
  },
  "packageManager": "yarn@4.2.2+sha256.1aa43a5304405be7a7cb9cb5de7b97de9c4e8ddd3273e4dad00d6ae3eb39f0ef",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier -w .",
    "build": "yarn workspaces foreach -A --exclude=. -t -iv run build",
    "packages:pack": "yarn npmignore --auto && yarn workspaces foreach -A --exclude=. -t -iv pack",
    "packages:publish:provenance": "yarn workspaces foreach -A --exclude=. exec npm publish --provenance"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "npmignore": "^0.3.1",
    "prettier": "2.8.8",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "ignore": [
      "!lib/*.js",
      "!lib/*.d.ts",
      "*.config.js",
      "src/",
      "test/"
    ]
  }
}
